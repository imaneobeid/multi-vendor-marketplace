PORT=5000
MONGO_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>.mongodb.net/marketplace?appName=marketplace
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
# The address(es) of the website, separated by commas if there are several
CLIENT_URL=http://localhost:3000

# OPTIONAL: store product photos on Cloudinary instead of in MongoDB.
# Leave these out to keep using MongoDB (no extra account needed).
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
